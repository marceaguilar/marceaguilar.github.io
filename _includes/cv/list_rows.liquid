<ul class="cv-entry-list">
  {% for content in cv_contents %}
    <li class="cv-entry-list-item">
      {% if content.text %}
        <div class="cv-entry-list-row">
          <span class="cv-entry-list-text">{{ content.text }}</span>
          {% if content.year %}
            <span class="cv-entry-list-year">{{ content.year }}</span>
          {% endif %}
        </div>
      {% else %}
        <div class="cv-entry-list-row">
          <span class="cv-entry-list-text">{{ content }}</span>
        </div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
